{
  "configurations": [
    {
      "name": "STM32",
      "configurationProvider": "ms-vscode.cmake-tools",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/Core/Inc",
        "${workspaceFolder}/lib/mavlink"
      ],
      "defines": [
        "STM32F103xB",
        "USE_HAL_DRIVER"
      ],
      "compilerPath": "arm-none-eabi-gcc",
      "cStandard": "c11"
    }
  ],
  "version": 4
}